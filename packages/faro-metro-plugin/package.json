{
  "name": "@grafana/faro-metro-plugin",
  "version": "0.3.1",
  "description": "Upload React Native (Metro + Hermes) source maps to the Faro source map API and inject Faro bundle id preamble",
  "type": "module",
  "main": "dist/cjs/index.cjs",
  "types": "dist/cjs/index.d.ts",
  "module": "dist/esm/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "bin": {
    "faro-upload-source-map": "bin/faro-upload-source-map.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/grafana/faro-javascript-bundler-plugins",
    "directory": "packages/faro-metro-plugin"
  },
  "license": "Apache-2.0",
  "author": "Grafana Labs",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "@grafana/faro-bundlers-shared": "^0.11.1",
    "@grafana/faro-cli": "^0.11.1",
    "cross-fetch": "^4.0.0",
    "source-map": "^0.8.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@grafana/tsconfig": "2.2.0",
    "@jest/globals": "30.4.1",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "jest": "30.4.2",
    "metro": "0.87.0",
    "ts-jest": "29.4.12",
    "tsdown": "0.22.14",
    "tslib": "2.8.1",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "metro": ">=0.81.0"
  },
  "files": [
    "android",
    "bin",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
