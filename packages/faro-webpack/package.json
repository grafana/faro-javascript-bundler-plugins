{
  "name": "@grafana/faro-webpack-plugin",
  "version": "0.12.2",
  "description": "Upload a source map to the Faro source map API from a Webpack build pipeline ",
  "type": "module",
  "main": "dist/cjs/index.cjs",
  "types": "dist/cjs/index.d.ts",
  "module": "dist/esm/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/grafana/faro-javascript-bundler-plugins",
    "directory": "packages/faro-webpack"
  },
  "license": "Apache-2.0",
  "author": "Grafana Labs",
  "scripts": {
    "build": "rollup --config rollup.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "@grafana/faro-bundlers-shared": "^0.11.1",
    "webpack": "^5.89.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/preset-env": "8.0.2",
    "@babel/preset-typescript": "8.0.1",
    "@grafana/tsconfig": "2.2.0",
    "@jest/globals": "30.4.1",
    "@rollup/plugin-babel": "7.1.0",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "babel-jest": "30.4.1",
    "jest": "30.4.2",
    "rollup": "4.62.2",
    "ts-jest": "29.4.12",
    "typescript": "6.0.3"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
