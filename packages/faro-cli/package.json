{
  "name": "@grafana/faro-cli",
  "version": "0.12.0",
  "description": "CLI for uploading sourcemaps to the Faro source map API",
  "type": "module",
  "main": "dist/cjs/index.cjs",
  "types": "dist/cjs/index.d.cts",
  "module": "dist/esm/index.mjs",
  "bin": "dist/cjs/cli.cjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./cli": {
      "import": {
        "types": "./dist/cjs/cli.d.cts",
        "default": "./dist/cjs/cli.cjs"
      },
      "require": {
        "types": "./dist/cjs/cli.d.cts",
        "default": "./dist/cjs/cli.cjs"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/grafana/faro-javascript-bundler-plugins",
    "directory": "packages/faro-cli"
  },
  "license": "Apache-2.0",
  "author": "Grafana Labs",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@grafana/faro-bundlers-shared": "^0.12.0",
    "commander": "^15.0.0",
    "dotenv": "^17.0.1",
    "glob": "^13.0.0",
    "tar": "^7.5.21"
  },
  "devDependencies": {
    "@grafana/tsconfig": "2.2.0",
    "@types/glob": "9.0.0",
    "@types/node": "24.13.3",
    "@types/tar": "7.0.87",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
